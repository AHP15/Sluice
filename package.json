    "check:webview": "bun scripts/check-webview-safety.mjs",
    "check:exact": "bun scripts/check-exact-numeric.mjs",
    "test:unit": "bun test tests/unit",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
